# ── 텔레그램 ──────────────────────────────────────────────
# https://my.telegram.org → API development tools 에서 발급 (모드 상관없이 필요)
TG_API_ID=
TG_API_HASH=

# 봇 모드: @BotFather 에서 받은 토큰. 봇이 들어가 있는 채팅/봇에게 온 메시지만 전달.
# 비워 두면 '사용자 모드': 내 계정으로 로그인해서 내가 볼 수 있는 모든 채팅/채널 전달 가능.
TG_BOT_TOKEN=

# 전달할 채팅. 쉼표로 여러 개. @username 또는 숫자 ID(-100으로 시작하는 채널 ID 포함).
# `python tg2discord.py chats` 로 ID 확인. 비우면 들어오는 모든 메시지 전달.
TG_SOURCE_CHATS=

# 내가 보낸 메시지도 전달할지 (기본 false)
FORWARD_OUTGOING=false

# ── 디스코드 (둘 중 하나 이상) ─────────────────────────────
# 1) 채널로 보내기: 서버 설정 → 연동 → 웹후크 → 새 웹후크 → URL 복사
DISCORD_WEBHOOK_URL=

# 2) 특정 사람 DM: 디스코드 봇 토큰 + 받는 사람 사용자 ID (쉼표로 여러 명)
#    받는 사람은 봇과 같은 서버에 있어야 하고, 서버 멤버 DM 허용 상태여야 함
DISCORD_BOT_TOKEN=
DISCORD_USER_IDS=

# ── 기타 ──────────────────────────────────────────────────
# 디스코드 첨부 한도(무료 서버 기준 10MB). 넘으면 파일은 빼고 안내문만 전송
MAX_FILE_MB=10
# 메시지 시간 표시 기준 (한국 9)
TZ_OFFSET_HOURS=9
